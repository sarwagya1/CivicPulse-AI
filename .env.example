# ==============================================================================
# CivicPulse AI — Environment Configuration Template
# ==============================================================================
# Copy this file to `backend/.env` for backend configuration.
# DO NOT commit the actual `.env` file containing real secret keys to GitHub.

# ------------------------------------------------------------------------------
# Open Data & Machine Learning API Keys
# ------------------------------------------------------------------------------
# HuggingFace API Token (Free from https://huggingface.co/settings/tokens)
HF_API_TOKEN=your_huggingface_api_token_here

# Open Government Data India API Key (Free from https://data.gov.in)
DATA_GOV_API_KEY=your_data_gov_india_key_here

# Optional: Google Gemini Vision API Key (assistive cloud vision validation fallback)
# Can also be set as GOOGLE_API_KEY
GEMINI_API_KEY=your_optional_gemini_api_key_here

# ------------------------------------------------------------------------------
# Backend & CORS Configuration
# ------------------------------------------------------------------------------
# Comma-separated allowed frontend origins for FastAPI CORS middleware
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ------------------------------------------------------------------------------
# SMTP Email Notification Service (Optional)
# ------------------------------------------------------------------------------
# Used by the Grievance Portal to send automated confirmation emails with tracking tokens.
# If left blank, grievance submissions will still succeed and display tokens on screen.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password_here
SMTP_FROM=CivicPulse AI <notifications@civicpulse.gov.in>
SMTP_USE_TLS=true

# ------------------------------------------------------------------------------
# Frontend Environment Variable (Optional)
# ------------------------------------------------------------------------------
# If deploying frontend separately from backend, set VITE_API_URL in frontend build.
# In local development, Vite proxies `/api` requests to `http://localhost:8000`.
# VITE_API_URL=http://localhost:8000/api
