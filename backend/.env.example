# Environment variables — copy to .env and fill in your keys
HF_API_TOKEN=your_huggingface_api_token_here
DATA_GOV_API_KEY=your_data_gov_india_key_here
GEMINI_API_KEY=your_optional_gemini_api_key_here
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# SMTP Email Delivery Configuration (Optional — for grievance confirmation emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=CivicPulse AI <alerts@civicpulse.gov.in>
SMTP_USE_TLS=true
